rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Backpack Collection:
    // ALL user and organization identity data (accreditationDocUrl, accreditationStatus,
    // accreditingBody, address, baseCurrency, description, id, isAccredited, kycDocumentUrl,
    // location, name/fullname, orgType, ownerId, registrationId, courses, progress, enrollments)
    // reside strictly inside backpack/{userId} -> user -> personalInformation / courses / etc.
    // No separate organization or user-type collections are created.
    match /backpack/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isOwner(userId);
    }

    // Real-time course chat messages
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback rule for any other collection documents
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
